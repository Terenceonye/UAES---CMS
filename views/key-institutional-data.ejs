<%- include("websitepartials/header") %>

<style>
  .logo {
    width: 80px;
  }

  .card-box {
    border-radius: 20px;
    padding: 25px;
    color: white;
  }

  .blue {
    background: linear-gradient(to right, #3f51b5, #2196f3);
  }

  .orange {
    background: linear-gradient(to right, #ff5722, #ff9800);
  }

  .purple {
    background: linear-gradient(to right, #9c27b0, #e91e63);
  }

  .green {
    background: linear-gradient(to right, #4caf50, #8bc34a);
  }

  .rounded-card {
    border-radius: 15px;
    overflow: hidden;
  }

  table {
    margin-bottom: 0;
  }

  .icon-box {
    font-size: 2rem;
    margin-bottom: 10px;
  }
</style>

<main class="main">
  <!-- Page Title -->
  <div
    class="page-title dark-background"
    style="
      background-image: url('website-assets/img/gallery/Dr-Basilia-Igbokwe3.jpg');
      background-size: cover;
      background-position: center;
    "
  >
    <div class="container position-relative text-white py-5">
      <h1 class="display-4 fw-bold">Key Institutional Data</h1>
      <p class="lead">
        Explore the financial, population, and strategic resource data that
        drive our institution forward.
      </p>
      <nav class="breadcrumbs mt-3">
        <ol class="breadcrumb bg-transparent p-0 m-0">
          <li class="breadcrumb-item">
            <a href="/" class="text-white text-decoration-underline">Home</a>
          </li>
          <li class="breadcrumb-item active text-white" aria-current="page">
            Key Institutional Data
          </li>
        </ol>
      </nav>
    </div>
  </div>

  <section id="leadership" class="leadership section mx-2 mx-lg-4">
    <div class="containter">
      <div class="text-center mb-4">
        <img
          src="website-assets/img/favicon.png"
          class="mb-2"
          alt="UISTO Logo"
          width="150px"
        />
        <h2 class="fw-bold">Key Institutional Data</h2>
      </div>

      <div class="row g-4 mb-4">
        <div class="col-md-6">
          <div class="card-box blue text-center text-white">
