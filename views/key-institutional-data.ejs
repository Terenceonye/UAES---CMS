                  </tr>
                  <tr>
                    <td colspan="2"><strong>TOTAL</strong></td>
                    <td><strong>₦1,984,355,731.71</strong></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- Footer Note -->
      <p class="text-center mt-4 text-muted">
        Data last updated: <strong>June 03, 2025</strong> | Source:
        <strong>Federal Polytechnic Nekede, Owerri Imo State</strong>
      </p>
    </div>
  </section>
</main>

<%- include("websitepartials/footer") %>
