                  <tr>
                    <th>S/N</th>
                    <th>Item</th>
                    <th>Amount</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>1</td>
                    <td>Personnel Cost</td>
                    <td>₦9,604,583,755.00</td>
