                  </tr>
                  <tr>
                    <td>8</td>
                    <td>TET Fund Project Maintenance</td>
                    <td>₦150,000,000.00</td>
                  </tr>
                  <tr>
                    <td>9</td>
                    <td>Equipment Fabrication</td>
