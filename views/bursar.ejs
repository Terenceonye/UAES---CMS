<%- include("websitepartials/header") %>
  <main class="main">

    <!-- Page Title -->
    <div class="page-title dark-background"
      style="background-image: url(website-assets/img/gallery/Dr-Basilia-Igbokwe3.jpg);">
      <div class="container position-relative">
        <h1>Rector</h1>
        <p>Office of the Bursar</p>
        <nav class="breadcrumbs">
          <ol>
            <li><a href="/">Home</a></li>
            <li class="current">Administration</li>
          </ol>
        </nav>
      </div>
    </div><!-- End Page Title -->



    <section id="admissions" class="admissions section pb-0">
      <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="row gy-5 g-lg-5">
          <div class="col-lg-6">
            <div class="admissions-info" data-aos="fade-up">
              <h2>Overview of the Bursary Department</h2>
              <p>The Bursary is responsible for the management of the Polytechnic’s financial activities. It plays a
                strategic advisory role to the Council and Management while ensuring financial policies and goals are
                met. Key functions include:

              </p>

              <div class="admissions-steps mt-5">
                <div class="steps-wrapper mt-4">
                  <div class="step-item" data-aos="fade-up" data-aos-delay="100">
                    <div class="step-number">1</div>
                    <div class="step-content">
                      <p>Developing and implementing accounting and financial management systems.</p>
                    </div>
                  </div>

                  <div class="step-item" data-aos="fade-up" data-aos-delay="200">
                    <div class="step-number">2</div>
                    <div class="step-content">
                      <p>Preparing periodic financial statements in compliance with IFRS.</p>
                    </div>
                  </div>

                  <div class="step-item" data-aos="fade-up" data-aos-delay="300">
                    <div class="step-number">3</div>
                    <div class="step-content">
                      <p>Maintaining records of the Polytechnic's assets.</p>
                    </div>
                  </div>

                  <div class="step-item" data-aos="fade-up" data-aos-delay="400">
                    <div class="step-number">4</div>
                    <div class="step-content">
                      <p>Executing annual audits and managing budgets.</p>
                    </div>
                  </div>

                  <div class="step-item" data-aos="fade-up" data-aos-delay="500">
                    <div class="step-number">5</div>
                    <div class="step-content">
                      <p>Monitoring donor funds to ensure proper utilization.</p>
                    </div>
                  </div>
                </div>
              </div>



            </div>
          </div>

          <div class="col-lg-6" id="bursary-structure">
            <div class="admissions-requirements" data-aos="fade-up">
              <h3>The Bursary is structured into the following units:</h3>
              <div class="requirements-list mt-4">

                <div class="requirement-item" data-aos="fade-up" data-aos-delay="100">
                  <div class="icon-box">
                    <i class="bi bi-journal-check"></i>
                  </div>
                  <div>
                    <h4>Final Account and Reports Unit</h4>
                    <p>Responsible for preparing the institution’s financial statements and ensuring regulatory
                      compliance.</p>
                  </div>
                </div>

                <div class="requirement-item" data-aos="fade-up" data-aos-delay="200">
                  <div class="icon-box">
                    <i class="bi bi-bar-chart-steps"></i>
                  </div>
                  <div>
                    <h4>Budget and Budgetary Control Unit</h4>
                    <p>Manages budget preparation, implementation, and monitors expenditure against allocations.</p>
                  </div>
                </div>

                <div class="requirement-item" data-aos="fade-up" data-aos-delay="300">
                  <div class="icon-box">
                    <i class="bi bi-credit-card-2-back"></i>
                  </div>
                  <div>
                    <h4>Payroll/Salary Unit</h4>
                    <p>Handles staff salary processing, deductions, remittances, and IPPIS-related documentation.</p>
                  </div>
                </div>

                <div class="requirement-item" data-aos="fade-up" data-aos-delay="400">
                  <div class="icon-box">
                    <i class="bi bi-person-badge"></i>
                  </div>
                  <div>
                    <h4>Student Accounts Unit</h4>
                    <p>Manages student billing, fee payments, and reconciles students' financial records.</p>
                  </div>
                </div>

                <div class="requirement-item" data-aos="fade-up" data-aos-delay="500">
                  <div class="icon-box">
                    <i class="bi bi-bag-check"></i>
                  </div>
                  <div>
                    <h4>Procurement Unit</h4>
                    <p>Oversees purchasing activities, vendor management, and procurement compliance.</p>
                  </div>
                </div>

                <div class="requirement-item" data-aos="fade-up" data-aos-delay="600">
                  <div class="icon-box">
                    <i class="bi bi-archive"></i>
                  </div>
                  <div>
                    <h4>Stores Unit</h4>
                    <p>Maintains inventory, tracks stock levels, and ensures safe storage of procured items.</p>
                  </div>
                </div>

                <div class="requirement-item" data-aos="fade-up" data-aos-delay="700">
                  <div class="icon-box">
                    <i class="bi bi-cash-coin"></i>
                  </div>
                  <div>
                    <h4>Treasury/Finance Unit</h4>
                    <p>Handles cash management, bank reconciliations, and institutional financial transactions.</p>
                  </div>
                </div>

              </div>
            </div>

          </div>
        </div>

      </div>
    </section>

    <!-- Bursar Section -->
    <section id="alumni" class="alumni section pb-0">
      <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="impact-banner" data-aos="fade-up" data-aos-delay="200">
          <div class="row align-items-center">
            <div class="col-lg-7">
              <div class="impact-content">
                <h3 class="mb-3">About the Bursar</h3>
                <p class="w-sm-100">
                  Mrs. Ojiuko Adanne Chinyere
                </p>
                <p>
                  Mrs. Ojiuko Adanne Chinyere is a seasoned Chartered Accountant and financial expert with over 25 years
                  of experience in both public and private finance management. She holds an MBA in Finance and is a
                  Fellow of the Institute of Chartered Accountants of Nigeria (ICAN). Before her appointment as the
                  Bursar of the UNIVERSITY OF AGRICULTURE AND ENVIRONMENTAL SCIENCE (UAES), UMUAGWO, she served in various senior finance roles, contributing
                  significantly to institutional financial reforms and strategic fiscal planning.
                </p>
                <p>
                  As the Chief Financial Officer of the Polytechnic, she is responsible for overseeing budgetary
                  operations, enhancing revenue generation strategies, and ensuring compliance with government financial
                  regulations.
                </p>
                <div class="impact-buttons">
                  <a href="/mission-vision-objectives" class="btn-donate">Our Vision</a>
                  <a href="/rector-message" class="btn-learn-more">Rector's Message <i
                      class="bi bi-arrow-right"></i></a>
                </div>
              </div>
            </div>
            <div class="col-lg-5">
              <div class="impact-image">
                <img src="website-assets/img/council/new-bursar.png" alt="Mrs. Ojiuko Adanne Chinyere"
                  class="img-fluid">
                <div class="impact-stat">
                  <i class="bi bi-person-circle me-2"></i>
                  <span class="stat-text">Mrs. Ojiuko Adanne Chinyere</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>


    <section id="admissions" class="admissions section pb-0">
      <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="row gy-5 g-lg-5">
          <div class="col-lg-12">
            <div class="admissions-info" data-aos="fade-up">
              <div class="admissions-steps mt-5">
                <h3>Strategic Focus Areas and Ongoing Achievements</h3>
                <div class="steps-wrapper mt-4">
                  <div class="step-item" data-aos="fade-up" data-aos-delay="100">
                    <div class="step-number">1</div>
                    <div class="step-content">
                      <p>Initiated a comprehensive audit review to enhance transparency, accountability, and proper
                        documentation in the Polytechnic’s financial operations.</p>
                    </div>
                  </div>

                  <div class="step-item" data-aos="fade-up" data-aos-delay="200">
                    <div class="step-number">2</div>
                    <div class="step-content">
                      <p>Commenced automation of key financial workflows to improve efficiency, minimize human error,
                        and fast-track processing of transactions and reports.</p>
                    </div>
                  </div>

                  <div class="step-item" data-aos="fade-up" data-aos-delay="300">
                    <div class="step-number">3</div>
                    <div class="step-content">
                      <p>Strengthened revenue generation by reviewing and optimizing Internally Generated Revenue (IGR)
                        channels and introducing digital payment tracking systems.</p>
                    </div>
                  </div>

                  <div class="step-item" data-aos="fade-up" data-aos-delay="400">
                    <div class="step-number">4</div>
                    <div class="step-content">
                      <p>Fostered stronger compliance culture by aligning all financial activities with national public
                        financial management standards and frameworks.</p>
                    </div>
                  </div>

                  <div class="step-item" data-aos="fade-up" data-aos-delay="500">
                    <div class="step-number">5</div>
                    <div class="step-content">
                      <p>Established new internal controls and checks to mitigate financial risks and eliminate revenue
                        leakages.</p>
                    </div>
                  </div>

                  <div class="step-item" data-aos="fade-up" data-aos-delay="600">
                    <div class="step-number">6</div>
                    <div class="step-content">
                      <p>Implemented capacity-building programs and continuous professional development for Bursary
                        staff to enhance performance and service delivery.</p>
                    </div>
                  </div>

                  <div class="step-item" data-aos="fade-up" data-aos-delay="700">
                    <div class="step-number">7</div>
                    <div class="step-content">
                      <p>Promoted a paperless workflow initiative to reduce waste and promote sustainable financial
                        practices across all departments.</p>
                    </div>
                  </div>

                  <div class="step-item" data-aos="fade-up" data-aos-delay="800">
                    <div class="step-number">8</div>
                    <div class="step-content">
                      <p>Strengthened collaboration with regulatory and supervisory bodies including the Office of the
                        Accountant-General of the Federation, NBTE, and ICPC.</p>
                    </div>
                  </div>

                  <div class="step-item" data-aos="fade-up" data-aos-delay="900">
                    <div class="step-number">9</div>
                    <div class="step-content">
                      <p>Initiated restructuring of key budget processes to support strategic priorities and optimize
                        resource allocation across academic and administrative units.</p>
                    </div>
                  </div>

                  <div class="step-item" data-aos="fade-up" data-aos-delay="1000">
                    <div class="step-number">10</div>
                    <div class="step-content">
                      <p>Working toward full digitization of payroll management to ensure speed, accuracy, and
                        timeliness of staff payments through IPPIS and e-payment platforms.</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
    </section>


    <section id="admissions" class="admissions section">
      <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="cta-wrapper mt-5" data-aos="fade-up">
          <div class="row g-0">
            <div class="col-md-6">
              <div class="cta-item tour">
                <i class="bi bi-bar-chart-line"></i>
                <h3>Financial & Key Institutional Data</h3>
                <p>Gain insights into the Polytechnic’s financial TETFund allocations, budget utilization, and
                  student population statistics.</p>
                <a href="/key-institutional-data" class="btn btn-secondary">Explore Data</a>
              </div>
            </div>

            <div class="col-md-6">
              <div class="cta-item apply">
                <i class="bi bi-question-circle"></i>
                <h3>Need Financial Clarification?</h3>
                <p>Have questions about payments, salaries, student accounts, or procurement? We're here to help.</p>
                <a href="/contact" class="btn btn-primary">Contact the Bursary</a>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

  </main>

  <%- include("websitepartials/footer") %>