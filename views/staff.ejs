    <style>
        .upload-card {
            background: #fff;
            border-radius: 12px;
            padding: 20px 25px 30px;
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
            width: 100%;
            text-align: center;
            user-select: none;
        }

        .upload-card h5 {
            margin-bottom: 20px;
            font-weight: 600;
            font-size: 1.2rem;
            color: #222;
        }

        #profileImage {
            display: none;
        }

        label[for="profileImage"] {
            display: inline-block;
            background-color: #4a90e2;
            color: white;
            padding: 10px 25px;
            border-radius: 25px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.95rem;
            transition: background-color 0.3s ease, opacity 0.3s ease, cursor 0.3s ease;
            box-shadow: 0 3px 6px rgba(74, 144, 226, 0.3);
            user-select: none;
        }

        label[for="profileImage"]:hover {
            background-color: #357ABD;
        }

        label[for="profileImage"].disabled {
            opacity: 0.6;
            cursor: not-allowed;
            background-color: #4a90e2;
        }

        #image-container {
            position: relative;
            width: 180px;
            height: 180px;
            margin: 20px auto 0;
            border-radius: 50%;
            border: 4px solid #4a90e2;
            overflow: hidden;
            background: #e0e7ff;
            box-shadow: 0 6px 18px rgba(74, 144, 226, 0.2);
        }

        #preview {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            border-radius: 50%;
        }

        canvas {
            position: absolute !important;
            top: 0;
            left: 0;
            border-radius: 50%;
            pointer-events: none;
            user-select: none;
        }

        #message {
            margin-top: 16px;
            font-weight: 500;
            color: #444;
            font-size: 0.9rem;
            min-height: 20px;
            transition: color 0.3s ease;
        }
    </style>

