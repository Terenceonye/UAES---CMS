<%- include("websitepartials/header") %>
<main class="main">
  <!-- Page Title -->
  <div
    class="page-title dark-background"
    style="
      background-image: url(website-assets/img/gallery/Dr-Basilia-Igbokwe3.jpg);
    "
  >
    <div class="container position-relative">
      <h1>About</h1>
      <p>Rector's Welcome Message</p>
      <nav class="breadcrumbs">
        <ol>
          <li><a href="/">Home</a></li>
          <li class="current">About</li>
        </ol>
      </nav>
    </div>
  </div>
  <!-- End Page Title -->

  <!-- Leadership Section -->
  <section id="leadership" class="leadership section">
    <div class="container" data-aos="fade-up" data-aos-delay="100">
      <div class="row mb-5">
        <div class="col-lg-6" data-aos="fade-right" data-aos-delay="200">
          <h3 class="section-subtitle">The Rector's Message</h3>
          <h2 class="section-heading">
            You are welcome to UNIVERSITY OF AGRICULTURE AND ENVIRONMENTAL
            SCIENCE (UAES), UMUAGWO.
          </h2>
          <p class="section-description">
            The Federal Polytechnic, Nekede is a federal government-owned higher
            institution located in Nekede, Owerri West local government area in
            Imo State, South-Eastern Nigeria.
          </p>
          <p class="section-description">
            It was established on a temporary site at the premise of Government
            Technical College by the Imo State government in 1978 as College of
            Technology, Owerri before it was moved to its present location in
            Nekede.
          </p>
          <p class="section-description">
            On 7 April 1993, the polytechnic was changed to a federal government
            institution and was renamed “The Federal Polytechnic, Nekede
          </p>
          <div class="stats-container mt-4">
            <div class="row">
              <div class="col-md-4 col-6">
                <div class="stat-item">
                  <h3>25+</h3>
                  <p>Years of Excellence</p>
                </div>
              </div>
              <div class="col-md-4 col-6">
                <div class="stat-item">
                  <h3>120+</h3>
                  <p>Staff Members</p>
                </div>
              </div>
              <div class="col-md-4 col-6">
                <div class="stat-item">
                  <h3>98%</h3>
                  <p>Student Success</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-6" data-aos="fade-left" data-aos-delay="300">
          <div
            style="
              background-color: #111;
              border-radius: 12px;
              overflow: hidden;
              box-shadow: 0 10px 20px rgba(0, 0, 0, 0.25);
            "
          >
            <img
              src="website-assets/img/person/rector.png"
              alt="Dr. Mrs. Basilia Igbokwe"
              style="
                width: 100%;
                height: 450px;
                object-fit: cover;
                object-position: top;
                display: block;
              "
            />

            <div
              style="
                padding: 1.5rem;
                background: rgba(10, 130, 184);
                color: #fff;
                text-align: left;
              "
            >
              <h3
                style="
                  font-size: 1.5rem;
                  font-weight: 600;
                  margin-bottom: 0.25rem;
                  color: white;
                "
              >
                Dr. Mrs. Basilia Igbokwe
              </h3>

              <p style="font-size: 1rem; color: #ddd; margin-bottom: 0.75rem">
                Rector
              </p>

              <p style="font-size: 0.95rem; margin: 0">
                <strong>Email:</strong>
                <a
                  href="mailto:rector@UISTO.edu.ng"
                  style="color: #ddd; text-decoration: underline"
                  >rector@UISTO.edu.ng</a
                >
              </p>
            </div>
          </div>
        </div>

        <!-- Responsive Adjustment -->
        <style>
          @media (max-width: 576px) {
            div[data-aos="fade-left"] img {
              height: 400px !important;
            }

            div[data-aos="fade-left"] div[style*="padding: 1.5rem"] {
              text-align: center !important;
              padding: 1rem !important;
            }

            div[data-aos="fade-left"] h3 {
              font-size: 1.25rem !important;
            }

            div[data-aos="fade-left"] p {
              font-size: 0.95rem !important;
            }
          }
        </style>
      </div>
    </div>
  </section>
  <!-- /Leadership Section -->
</main>

<%- include("websitepartials/footer") %>
