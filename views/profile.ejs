<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" href="/assets/img/favicon.png" type="image/x-icon">
    <title>Lecturer Profile</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <style>
        body {
            background-color: #f7f7f7;
            font-family: 'Segoe UI', sans-serif;
        }

        .text-primary {
            color: #0a82b8 !important;
        }

        input:focus,
        select:focus,
        button:focus,
        .pagination-controls nav ul li a:focus {
            box-shadow: none !important;
            border-color: #0a82b8 !important;
        }

        .profile-container {
            display: flex;
            flex-direction: row;
            gap: 30px;
            border-radius: 8px;
            overflow: hidden;
        }

        .profile-left {
            background-color: #114b8b;
            color: white;
            padding: 2rem;
            width: 300px;
            text-align: center;
        }

        .profile-left img {
            border-radius: 50%;
            width: 150px;
            height: 150px;
            margin-bottom: 1rem;
        }

        .profile-left h4 {
            font-weight: bold;
        }

        .profile-left .info {
            margin-top: 1rem;
            font-size: 14px;
        }

        .profile-left .info i {
            margin-right: 8px;
        }

        .profile-right {
            flex: 1;
        }

        #profileTabs {
            background-color: white;
            padding: 10px;
            border-radius: 8px;
        }

        .nav-tabs .nav-link {
            color: #114b8b;
        }

        .nav-tabs .nav-link.active {
            font-weight: bold;
            border-bottom: 3px solid #d1634a;
            color: #d1634a;
        }

        .tab-content {
            padding: 0.5rem 0;
            border-radius: 8px;
            margin-top: 1rem;
        }

        /* .tab-pane {
            background-color: white;
            padding: 1rem;
            border-radius: 8px;
        } */

        .tab-part {
            background-color: white;
            border-radius: 10px;
            padding: 1rem;
            margin-bottom: 1rem;
        }

        .tab-part h5 {

            color: #0a82b8;
            margin-bottom: 1rem;
        }


        .tab-part ul li {
            margin-bottom: 0.5rem
        }

        .tab-part ul li span {
            display: block;
        }

        .tab-content p {
            text-align: justify;
        }



        .custom-dotted-hr {
            border: none;
            height: 2px;
            background-image: repeating-linear-gradient(to right,
                    white,
                    white 2px,
                    transparent 6px,
                    transparent 10px);
            margin: 1rem 0;
            width: 100%;
        }

        .idnumber {
            background-color: white;
            color: #d1634a;
            height: 30px;
            width: 30px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
        }

        .fas.mt-1,
        .fab.mt-1 {
            background-color: rgba(255, 255, 255, 0.158);
            color: #fff;
            height: 30px;
            width: 30px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            flex-shrink: 0;
            margin-right: 0.5rem;
        }

        @media (max-width: 768px) {
            .profile-container {
                flex-direction: column;
            }

            .profile-left,
            .profile-right {
                width: 100%;
            }
        }

        .back-link {
            /* font-size: 14px; */
            color: #0a82b8;
            cursor: pointer;
        }


        /* SKELETON LOADER */

        .skeleton {
            background-color: #e2e2e2;
            border-radius: 4px;
            animation: pulse 1.5s infinite ease-in-out;
        }

        .skeleton.text {
            height: 14px;
            margin-bottom: 10px;
            width: 100%;
        }

        .skeleton.title {
            height: 20px;
            width: 60%;
        }

        .skeleton.circle {
            border-radius: 50%;
            height: 150px;
            width: 150px;
            margin: 0 auto 1rem;
        }

        .skeleton.line {
            height: 14px;
            margin: 8px 0;
            width: 80%;
        }

        @keyframes pulse {
            0% {
                opacity: 1;
            }

            50% {
                opacity: 0.4;
            }

            100% {
                opacity: 1;
            }
        }


        .bio-skeleton-line,
        .bio-skeleton-title {
            background-color: #e4e4e4;
            border-radius: 5px;
            margin-bottom: 10px;
            position: relative;
            overflow: hidden;
        }

        .bio-skeleton-line::after,
        .bio-skeleton-title::after {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            height: 100%;
            width: 100%;
            background: linear-gradient(to right, transparent 0%, rgba(255, 255, 255, 0.2) 50%, transparent 100%);
            animation: bioShimmer 1.3s infinite;
        }

        .bio-skeleton-line {
            height: 14px;
        }

        .bio-skeleton-title {
            height: 18px;
            width: 120px;
        }

        @keyframes bioShimmer {
            100% {
                left: 100%;
            }
        }



        .base-info div a {
            color: white;
        }
    </style>
</head>

