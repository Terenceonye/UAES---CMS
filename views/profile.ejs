        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const tabList = document.getElementById('profileTabs');
                const tabItems = Array.from(tabList.querySelectorAll('.nav-item:not(.dropdown)'));
                const moreTabs = document.getElementById('moreTabs');
                const dropdownMenu = moreTabs.querySelector('.dropdown-menu');

                function updateTabsForScreen() {
                    const screenWidth = window.innerWidth;

                    // Reset
                    tabItems.forEach(tab => tab.classList.remove('d-none'));
                    dropdownMenu.innerHTML = '';
                    moreTabs.classList.add('d-none');

                    if (screenWidth < 992) { // md and smaller
                        const visibleTabs = tabItems.slice(0, 2);
                        const hiddenTabs = tabItems.slice(2);

                        hiddenTabs.forEach(tab => {
                            tab.classList.add('d-none');

                            const btn = tab.querySelector('button');
                            const newItem = document.createElement('li');
                            newItem.innerHTML = `<button class="dropdown-item" data-bs-toggle="tab" data-bs-target="${btn.dataset.bsTarget}">${btn.textContent}</button>`;
                            dropdownMenu.appendChild(newItem);
                        });

                        if (hiddenTabs.length > 0) {
                            moreTabs.classList.remove('d-none');
                        }
                    }
                }

                window.addEventListener('resize', updateTabsForScreen);
                updateTabsForScreen();
            });
        </script>



