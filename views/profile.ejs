        <script>
            document.addEventListener("DOMContentLoaded", async () => {
                const params = new URLSearchParams(window.location.search);
                const id = params.get("id");

                if (!id) {
                    document.getElementById("profile-container").innerHTML = "<p class='text-danger'>No staff ID provided.</p>";
                    return;
                }

                try {
                    const res = await fetch(`/api/staff?id=${id}`);
                    const result = await res.json();




                    if (!result.success || !result.staff) {
                        throw new Error("Staff not found.");
                    }

                    const staff = result.staff;

                    // console.log("This staff is", staff)

                    // document.getElementById('profileImage').src = staff.profileImage?.url
                    // document.getElementById('title').textContent = staff.title
                    // document.getElementById("fullName").textContent = staff.fullName.toUpperCase();
                    // document.getElementById("position").textContent = staff.position
                    // document.getElementById("degTitle").textContent = staff.idNumber || 'N/A';
                    // document.getElementById("phone").textContent = staff.phone
                    // document.getElementById("email").textContent = staff.email


                    // document.getElementById('affiliation').href = staff.affiliation || 'N/A'
                    // document.getElementById('collaboration').href = staff.externalLinks?.collaborationNetwork || 'N/A'
                    // document.getElementById('googleScholar').href = staff.externalLinks?.googleScholar || 'N/A';
                    // document.getElementById('researchGate').href = staff.externalLinks?.researchGate || 'N/A'






                    function populateProfileSidebar(staff) {
                        if (!staff) return;

                        // Profile image
                        const profileImage = document.getElementById('profileImage');
                        profileImage.src = staff.profileImage?.url || 'website-assets/img/person/avatar.png';
                        profileImage.alt = staff.fullName || 'Profile Photo';

                        // Title and full name
                        document.getElementById('title').textContent = staff.title || '';
                        document.getElementById('fullName').textContent = staff.fullName || '';

                        // Position
                        document.getElementById('position').textContent = staff.position || '';

                        // Phone, email, and address
                        document.getElementById('phone').textContent = staff.phone || '';
                        document.getElementById('email').textContent = staff.email || '';
                        // document.getElementById('college').textContent = staff.address || '';

                        // Affiliation
                        document.getElementById('affiliation').href = staff.affiliation || 'javascritp:void(0)';
                        // External Links
                        document.getElementById('collaboration').href = staff.externalLinks?.collaborationNetwork || 'javascritp:void(0)';
                        document.getElementById('googleScholar').href = staff.externalLinks?.googleScholar || 'javascritp:void(0)';
                        document.getElementById('researchGate').href = staff.externalLinks?.researchGate || 'javascritp:void(0)';


                        document.getElementById("degTitle").textContent = staff.idNumber || 'N/A';
                        document.getElementById('bio').textContent = staff.about.bio || 'No bio available';
                    }



                    // Populate degrees
                    const degreeList = document.getElementById("degreeList");
                    degreeList.innerHTML = "";

                    staff.about.degrees.forEach(degree => {
                        const li = document.createElement("li");

                        const [title, degName] = degree.split(" - ");

                        const strong = document.createElement("strong");
                        strong.textContent = title.trim();

                        const span = document.createElement("span");
                        span.className = "d-block";
                        span.textContent = degName?.trim() || "";

                        li.appendChild(strong);
                        li.appendChild(span);
                        degreeList.appendChild(li);
                    });




                    // Populate the profile sidebar
                    populateProfileSidebar(staff);

                    // Populate Research Outputs
                    renderResearchOutputs(staff.researchOutputs);

                    // Populate Research Interests and Grants
                    populateResearchTab(staff.research);

                    // Populate Professional Activities
                    populateProfessionalActivities(staff.professionalActivities);

                    // Populate Teaching Activities
                    populateTeachingActivities(staff.teachingActivities || []);




                    // REMOVE SKELETONS AND DISPLAY FETCHED CONTENTS
                    document.getElementById("profileLeftSkeleton").style.display = "none";
                    document.getElementById("profileLeft").style.display = "block";

                    document.getElementById("bioSkeleton").style.display = "none";
                    document.getElementById("aboutContent").style.display = "block";



                } catch (err) {
                    console.error("Error loading profile:", err);
                    document.getElementById("profile-container").innerHTML = "<p class='text-danger'>Failed to load profile.</p>";
                }
            });




            function renderResearchOutputs(outputs) {
                const container = document.getElementById("researchOutputsContainer");
                container.innerHTML = ""; // Clear any existing content

                outputs.forEach(output => {
                    const collaborators = output.collaborators.join(", ");
                    const dateStr = new Date(output.date).toLocaleDateString("en-GB", {
                        day: "numeric", month: "short", year: "numeric"
                    });

                    const card = `
      <div class="card mb-3">
        <div class="card-body">
          <div class="text-uppercase text-primary small mb-1">Research Output</div>
          <h6 class="card-title">${output.title}</h6>
          <div class="text-muted small mb-2">
            ${dateStr}
          </div>
          <div class="text-muted small mb-2">
            <i class="fas fa-user me-2"></i>${collaborators}
          </div>
          <div class="d-flex flex-wrap gap-3 mt-2">
            <a href="${output.pdfUrl}" target="_blank" class="btn btn-outline-danger btn-sm">
              <i class="fas fa-file-pdf me-1"></i>VIEW PDF
            </a>
            <a href="${output.pdfUrl}" download class="btn btn-outline-secondary btn-sm">
              <i class="fas fa-link me-1"></i>Download PDF
            </a>
          </div>
        </div>
      </div>
    `;

                    container.insertAdjacentHTML("beforeend", card);
                });
            }



            // Research Interests and grants
            function populateResearchTab(researchData) {
                const interests = researchData.interests || [];
                const grants = researchData.grants || [];

                // === Populate RESEARCH INTEREST ===
                const researchTab = document.querySelector('#research .tab-part:first-child');
                researchTab.innerHTML = `
    <h5>RESEARCH INTEREST</h5>
    ${interests.map(interest => `<p>${interest}</p>`).join("")}
  `;

                // === Populate GRANTS ===
                const grantContainer = document.querySelector('#research .tab-part:nth-child(2)');

                // Grant Cards
                const grantCards = grants.map(grant => {
                    const date = new Date(grant.date).toLocaleDateString("en-GB", {
                        year: "numeric", month: "short", day: "numeric"
                    });

                    return `
      <div class="card mb-3 shadow-sm border-1">
        <div class="card-body">
          <div class="text-uppercase text-primary small mb-1">GRANT</div>
          <h6 class="card-title">${grant.title}</h6>
          <div class="text-muted small mb-2">${grant.tag} &nbsp; • &nbsp; ${date}</div>
          <p class="mb-1 text-muted">${grant.description}</p>
        </div>
      </div>
    `;
                }).join("");

                // Insert Grant Cards after the filter controls
                const controls = grantContainer.querySelectorAll('.d-flex.justify-content-between.align-items-center');
                const insertAfter = controls[1]; // second row (sort + pagination)
                insertAfter.insertAdjacentHTML('afterend', grantCards);
            }



            // Populate Professional Activities
            function populateProfessionalActivities(professionalActivities = []) {
                const container = document.querySelector('#professional .tab-part');

                if (!container) return;

                // Clear existing content
                container.innerHTML = `
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
            <h5 class="mb-3">PROFESSIONAL ACTIVITIES</h5>
            
        </div>
        
    `;

                // Append cards
                professionalActivities.forEach(activity => {
                    const dateStr = new Date(activity.date).toLocaleDateString('en-GB', {
                        day: '2-digit', month: 'short', year: 'numeric'
                    });

                    const card = document.createElement('div');
                    card.className = 'card mb-3 shadow-sm border-1';
                    card.innerHTML = `
            <div class="card-body">
                <div class="text-uppercase text-primary small mb-1">${activity.type || 'PROFESSIONAL ACTIVITY'}</div>
                <h6 class="card-title">${activity.title}</h6>
                <div class="text-muted small mb-2">${dateStr}</div>
                <p class="mb-1 text-muted">${activity.description}</p>
            </div>
        `;

                    container.appendChild(card);
                });
            }




            //populateTeachingActivities(activities = []) {
            function populateTeachingActivities(teachingActivities = []) {
                const container = document.querySelector('#teaching .tab-part');
                if (!container) return;

                // Clear and set the structure
                container.innerHTML = `
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
            <h5 class="mb-3">TEACHING ACTIVITIES</h5>
           
        </div>
       
    `;

                // Create and append cards
                teachingActivities.forEach(activity => {
                    const start = new Date(activity.startDate).toLocaleDateString('en-GB', {
                        day: '2-digit', month: 'short', year: 'numeric'
                    });
                    const end = new Date(activity.endDate).toLocaleDateString('en-GB', {
                        day: '2-digit', month: 'short', year: 'numeric'
                    });

                    const card = document.createElement('div');
                    card.className = 'card mb-3 shadow-sm border-1';
                    card.innerHTML = `
            <div class="card-body">
                <div class="text-uppercase text-primary small mb-1">${activity.tag || 'MODULE COORDINATED'}</div>
                <h6 class="card-title">${activity.title}</h6>
                <div class="text-muted small mb-2">${start} - ${end}</div>
                <a href="${activity.link}" target="_blank" class="text-decoration-none small fw-semibold text-muted">
                    LEARN MORE<i class="fas fa-link ms-1"></i>
                </a>
            </div>
        `;

                    container.appendChild(card);
                });
            }

        </script>






</body>

</html>