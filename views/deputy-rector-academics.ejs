                      class="bi bi-arrow-right"></i></a>
                </div>
              </div>
            </div>
            <div class="col-lg-5">
              <div class="impact-image">
                <img src="website-assets/img/council/13.png" alt="Student scholarship recipients" class="img-fluid">
