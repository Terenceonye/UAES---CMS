            <div class="row text-center">
              <div class="col-md-4 col-6 mb-3">
                <div class="stat-item">
                  <h3 class="text-white fw-bold">25+</h3>
                  <p>Years of ICT Leadership</p>
                </div>
              </div>
              <div class="col-md-4 col-6 mb-3">
                <div class="stat-item">
                  <h3 class="text-white fw-bold">40+</h3>
                  <p>Systems & Services Deployed</p>
                </div>
              </div>
              <div class="col-md-4 col-6 mb-3">
