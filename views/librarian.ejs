<%- include("websitepartials/header") %>
<main class="main">
  <!-- Page Title -->
  <div
    class="page-title dark-background"
    style="
      background-image: url(website-assets/img/gallery/Dr-Basilia-Igbokwe3.jpg);
    "
  >
    <div class="container position-relative">
      <h1>Librarian</h1>
      <p>Office of the Librarian</p>
      <nav class="breadcrumbs">
        <ol>
          <li><a href="/">Home</a></li>
          <li class="current">Administration</li>
        </ol>
      </nav>
    </div>
  </div>
  <!-- End Page Title -->

  <!-- Alumni Section -->
  <section id="alumni" class="alumni section pb-0">
    <div class="container" data-aos="fade-up" data-aos-delay="100">
      <div class="impact-banner" data-aos="fade-up" data-aos-delay="200">
        <div class="row align-items-center">
          <div class="col-lg-7">
            <div class="impact-content">
              <h3 class="mb-3">Office of the Librarian</h3>

              <p>
                The Office of the Polytechnic Librarian manages the
                institution’s library services and resources.
              </p>

              <p>
                The Polytechnic Librarian oversees the acquisition,
                organization, and maintenance of library materials, ensuring
                access to relevant academic resources for students and staff.
              </p>

              <p>
                They also coordinate library operations, promote research
                support, and manage digital and physical collections to enhance
                learning and academic development within the institution.
              </p>
              <div class="impact-buttons">
                <a href="/mission-vision-objectives" class="btn-donate"
                  >Our Vision</a
                >
                <a href="/rector-message" class="btn-learn-more"
                  >Rector's Message <i class="bi bi-arrow-right"></i
                ></a>
              </div>
            </div>
          </div>
          <div class="col-lg-5">
            <div class="impact-image">
              <img
                src="website-assets/img/council/liberian.png"
                alt="registrar"
                class="img-fluid"
              />
              <div class="impact-stat">
                <i class="bi bi-person-circle me-2"></i>
                <span class="stat-text">Dr. Charles Obichiere</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="leadership" class="leadership section">
    <div class="container" data-aos="fade-up" data-aos-delay="100">
      <div class="row mb-5">
        <div class="col-lg-12" data-aos="fade-right" data-aos-delay="200">
          <h3 class="section-subtitle mb-3">Profile of the Librarian</h3>
          <div class="stats-container">
            <p>
              Dr. Obichiere holds a Bachelor of Library Studies (BLS), a Master
              of Science (M.Sc.) in Library Science, and a Doctorate (Ph.D.) in
              Library and Information Science. He is a chartered librarian
              registered with the Librarians Registration Council of Nigeria
              (LRCN) and an active member of the Nigerian Library Association.
            </p>

            <p>
              As the Polytechnic Librarian, Dr. Obichiere oversees the
              acquisition, organization, and maintenance of library materials,
              ensuring access to relevant academic resources for students and
              staff. He coordinates library operations, promotes research
              support, and manages both digital and physical collections to
              enhance learning and academic development within the institution.
            </p>

            <p>
              Before his current role, Dr. Obichiere served as the Public
              Relations Officer (PRO) of the institution. His dedication to
              service has earned him several honors, including a Certificate of
              Merit from the UNIVERSITY OF AGRICULTURE AND ENVIRONMENTAL SCIENCE
              (UAES), UMUAGWO in 2015 and a Certificate of Recognition and
              Commendation in 2021.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- /Leadership Section -->
</main>

<%- include("websitepartials/footer") %>
