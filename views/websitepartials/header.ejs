      <!-- Modal for Application-->
      <div
        class="modal fade"
        id="applyChoiceModal"
        tabindex="-1"
        aria-labelledby="applyChoiceLabel"
        aria-hidden="true"
      >
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content border-0 shadow">
            <div
              class="modal-header text-white"
              style="background-color: #002357"
            >
              <h5 class="modal-title" id="applyChoiceLabel">
                Choose Application Type
              </h5>
              <button
                type="button"
                class="btn-close btn-close-white"
                data-bs-dismiss="modal"
                aria-label="Close"
              ></button>
            </div>
            <div class="modal-body text-center">
              <p>Please select the type of application:</p>
              <div class="d-grid gap-2">
                <button id="applyND" class="btn btn-info">Apply for ND</button>
                <button id="applyHND" class="btn btn-dark">
                  Apply for HND
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Modal for login portal -->
      <div
        class="modal fade"
        id="portalChoiceModal"
        tabindex="-1"
        aria-labelledby="portalChoiceLabel"
        aria-hidden="true"
      >
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content border-0 shadow">
            <div
              class="modal-header text-white"
              style="background-color: #002357"
            >
              <h5 class="modal-title" id="portalChoiceLabel">
                Choose Login Type
              </h5>
              <button
                type="button"
                class="btn-close btn-close-white"
                data-bs-dismiss="modal"
                aria-label="Close"
              ></button>
            </div>
            <div class="modal-body text-center">
              <p>Please select the area to Login</p>
              <div class="d-grid gap-2">
                <button id="portalND" class="btn btn-info">ND Login</button>
                <button id="portalHND" class="btn btn-dark">HND Login</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Modal for Check Admission Status -->
      <div
        class="modal fade"
        id="admissionStatusChoiceModal"
        tabindex="-1"
        aria-labelledby="admissionStatusChoiceModal"
        aria-hidden="true"
      >
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content border-0 shadow">
            <div
              class="modal-header text-white"
              style="background-color: #002357"
            >
              <h5 class="modal-title" id="admissionStatusChoiceLabel">
                Choose Checker Type
              </h5>
              <button
                type="button"
                class="btn-close btn-close-white"
                data-bs-dismiss="modal"
                aria-label="Close"
              ></button>
            </div>
            <div class="modal-body text-center">
              <p>Choose ND or HND Admission Status Checker</p>
              <div class="d-grid gap-2">
                <button id="admissionStatusND" class="btn btn-info">
                  Check ND Admission Status
                </button>
                <button id="admissionStatusHND" class="btn btn-dark">
                  Check HND Admission Status
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Bootstrap 5 JS Bundle (includes Popper) -->
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

      <!-- JavaScript to handle modal and actions -->

      <!-- APPLICATION TYPE JS -->
      <script>
        document.addEventListener("DOMContentLoaded", () => {
          document.querySelectorAll(".show-apply-modal").forEach((button) => {
            button.addEventListener("click", () => {
              const modal = new bootstrap.Modal(
                document.getElementById("applyChoiceModal"),
              );
              modal.show();
            });
          });

          document.getElementById("applyND").addEventListener("click", () => {
            // alert("Application for ND is Coming Soon");
            window.open(
              "https://ndapplication.UISTO.edu.ng/Applicant/Form/PostJambFormInvoiceGeneration",
              "_blank",
            );
          });

          document.getElementById("applyHND").addEventListener("click", () => {
            // alert("You selected: Apply for HND");
            window.open(
              "https://hndportal.UISTO.edu.ng/students/getapplicationrrr",
              "_blank",
            );
          });
        });
      </script>

      <!-- PORTAL LOGIN JS -->
      <script>
        document.addEventListener("DOMContentLoaded", () => {
          document.querySelectorAll(".show-portal-modal").forEach((button) => {
            button.addEventListener("click", () => {
              const modal = new bootstrap.Modal(
                document.getElementById("portalChoiceModal"),
              );
              modal.show();
            });
          });

          document.getElementById("portalND").addEventListener("click", () => {
            //alert("ND Portal Login is Coming Soon");
            window.open("https://erp.UISTO.edu.ng/index.php?login", "_blank");
          });

          document.getElementById("portalHND").addEventListener("click", () => {
            window.open("https://hndportal.UISTO.edu.ng", "_blank");
          });
        });
      </script>

      <!-- ADMISSION STATUS CHECKER JS -->
      <script>
        document.addEventListener("DOMContentLoaded", () => {
          document
            .querySelectorAll(".show-admission-status-modal")
            .forEach((button) => {
              button.addEventListener("click", () => {
                const modal = new bootstrap.Modal(
                  document.getElementById("admissionStatusChoiceModal"),
                );
                modal.show();
              });
            });

          document
            .getElementById("admissionStatusND")
            .addEventListener("click", () => {
              //alert("ND Portal Login is Coming Soon");
              window.open(
                "https://ndapplication.UISTO.edu.ng/Applicant/Admission/CheckStatus",
                "_blank",
              );
            });

          document
            .getElementById("admissionStatusHND")
            .addEventListener("click", () => {
              window.open(
                "https://hndportal.UISTO.edu.ng/students/getapplicationrrr",
                "_blank",
              );
            });
        });
      </script>
