<%- include("websitepartials/header") %>
<main class="main">
  <!-- Page Title -->
  <div
    class="page-title dark-background"
    style="
      background-image: url(website-assets/img/gallery/Dr-Basilia-Igbokwe3.jpg);
    "
  >
    <div class="container position-relative">
      <h1>Rector</h1>
      <p>Office of the Rector</p>
      <nav class="breadcrumbs">
        <ol>
          <li><a href="/">Home</a></li>
          <li class="current">Administration</li>
        </ol>
      </nav>
    </div>
  </div>
  <!-- End Page Title -->

  <!-- Alumni Section -->
  <section id="alumni" class="alumni section pb-0">
    <div class="container" data-aos="fade-up" data-aos-delay="100">
      <div class="impact-banner" data-aos="fade-up" data-aos-delay="200">
        <div class="row align-items-center">
          <div class="col-lg-7">
            <div class="impact-content">
              <h3 class="mb-3">Office of the Rector</h3>

              <p>
                The Rector is the Chief Academic, Administrative, and Accounting
                Officer of the Polytechnic. She has the power to exercise
                general authority over both staff and students and is also
                responsible for discipline in the Polytechnic, subject to the
                general control of the Governing Council.
              </p>
              <div class="impact-buttons">
                <a href="/mission-vision-objectives" class="btn-donate"
                  >Our Vision</a
                >
                <a href="/rector-message" class="btn-learn-more"
                  >Rector's Message <i class="bi bi-arrow-right"></i
                ></a>
              </div>
            </div>
          </div>
          <div class="col-lg-5">
            <div class="impact-image">
              <img
                src="website-assets/img/council/12.png"
                alt="Student scholarship recipients"
                class="img-fluid"
              />
              <div class="impact-stat">
                <i class="bi bi-person-circle me-2"></i>
                <span class="stat-text">Dr. Mrs. Basilia Igbokwe</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="leadership" class="leadership section">
    <div class="container" data-aos="fade-up" data-aos-delay="100">
      <div class="row mb-5">
        <div class="col-lg-12" data-aos="fade-right" data-aos-delay="200">
          <h3 class="section-subtitle mb-3">Profile of the Rector</h3>
          <div class="stats-container">
            <p>
              Dr. (Mrs.) Basilia Igbokwe has been appointed the 9th Substantive
              Rector of the Federal Polytechnic Nekede, Owerri. The appointment,
              which is for a single term of five (5) years, is effective from
              Tuesday, 10th September, 2024.
            </p>

            <p>
              Until her new appointment, Dr. (Mrs.) Basilia Igbokwe was a Chief
              Lecturer in the Department of Humanities, School of General
              Studies of UNIVERSITY OF AGRICULTURE AND ENVIRONMENTAL SCIENCE
              (UAES), UMUAGWO, Owerri.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- /Leadership Section -->
</main>

<%- include("websitepartials/footer") %>
