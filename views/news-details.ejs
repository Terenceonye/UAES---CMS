        </div>

        <div class="article-wrapper">
          <aside class="table-of-contents" data-aos="fade-left">
            <h3>Contents</h3>
            <nav>
              <ul>
                <li><a href="#details" class="active">Ceremony Details</a></li>
                <li><a href="#attendance">Attendance Notice</a></li>
                <li><a href="#instructions">Instructions for Students</a></li>
