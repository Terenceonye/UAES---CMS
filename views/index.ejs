<script>
  async function fetchPrograms() {
    try {
      const res = await fetch("/api/programs?limit=6");
      const data = await res.json();

      if (!data.success) throw new Error("Failed to fetch programs");

      const container = document.getElementById("programsContainer");
      container.innerHTML = "";

      data.programs.forEach((program, index) => {
        const levelBadge = Array.isArray(program.level)
          ? program.level.filter((l) => l).join(" | ")
          : "";

        const duration = program.duration || " ";
        const credit = program.requiredCredit || " ";
        const types =
          program.programType?.map((pt) => pt.programTypeName).join(" | ") ||
          " ";
        const desc = program.description || "";
        const description =
          desc.length > 170 ? desc.slice(0, 170) + "..." : desc;

        const title = program.name || "";
        const image =
          program.programImage?.url ||
          "website-assets/img/education/placeholder.jpg";

        const html = `
          <div class="col-lg-6" data-aos="zoom-in" data-aos-delay="${
            100 + index * 100
          }">
            <div class="program-item">
              <div class="program-badge">${levelBadge}</div>
              <div class="row g-0">
                <div class="col-md-4">
                  <div class="program-image-wrapper">
                    <img src="${image}" class="img-fluid" alt="${title}">
                  </div>
                </div>
                <div class="col-md-8">
                  <div class="program-content">
                    <h3>${title}</h3>
                    <div class="program-highlights">
                      <span><i class="bi bi-clock"></i> ${duration}</span>
                      <span><i class="bi bi-check-lg"></i> ${credit} Credits</span>
                      <span><i class="bi bi-calendar3"></i> ${types}</span>
                    </div>
                    <p>${description}</p>
                    <a href="/faculty-staff" class="program-btn"><span>Learn More</span> <i class="bi bi-arrow-right"></i></a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        `;
        container.insertAdjacentHTML("beforeend", html);
      });
    } catch (err) {
      console.error("Error loading programs:", err);
    }
  }

  document.addEventListener("DOMContentLoaded", fetchPrograms);
</script>

