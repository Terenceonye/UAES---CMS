<script>
  document.addEventListener("DOMContentLoaded", async () => {
    try {
      const response = await fetch("/api/news"); // Adjust the API path if needed
      const data = await response.json();

      const newsList = data.news.slice(0, 3); // Take first 3 items only
      const row = document.querySelector("#recent-news .row.gy-4");

      newsList.forEach((newsItem, index) => {
        const col = document.createElement("div");
        col.className = "col-xl-4 col-md-6";
        col.setAttribute("data-aos", "fade-up");
        col.setAttribute("data-aos-delay", `${100 * (index + 1)}`);

        const imageUrl =
          newsItem.images && newsItem.images.length > 0
            ? newsItem.images[0].url
            : "website-assets/img/blog/default.png"; // fallback image

        const article = `
          <article>
            <div class="post-img">
              <img src="${imageUrl}" alt="${newsItem.title}" class="img-fluid">
            </div>
            <p class="post-category">${newsItem.newsTag || "General"}</p>
            <h2 class="title">
              <a href="/news?id=${newsItem._id}">${newsItem.title}</a>
            </h2>
            <p class="post-date text-end">
              <time datetime="${newsItem.createdAt}">${new Date(
                newsItem.createdAt,
              ).toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}</time>
            </p>
          </article>
        `;

        col.innerHTML = article;
        row.appendChild(col);
      });
    } catch (error) {
      console.error("Error loading news:", error);
    }
  });
</script>

<!-- POPULATING EVENTS SECTION -->
<script>
  document.addEventListener("DOMContentLoaded", async () => {
    try {
      const res = await fetch("/events-brief?page=1&limit=4");
      const data = await res.json();
      const events = data.events;
      const container = document.getElementById("event-list");

      const monthNames = [
        "JAN",
        "FEB",
        "MAR",
        "APR",
        "MAY",
        "JUN",
        "JUL",
        "AUG",
        "SEPT",
        "OCT",
        "NOV",
        "DEC",
      ];

      events.forEach((event) => {
        const date = new Date(event.date);
        const startTime = convertTo12Hour(event.startTime);
        const endTime = convertTo12Hour(event.endTime);
        const rawStart = formatForCalendar(date, event.startTime);
        const rawEnd = formatForCalendar(date, event.endTime);

        const col = document.createElement("div");
        col.className = "col-lg-6";

        const calendarUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(
          event.title,
        )}&dates=${rawStart}/${rawEnd}&details=${encodeURIComponent(
          event.description,
        )}&location=${encodeURIComponent(event.location || "Campus Venue")}`;

        col.innerHTML = `
          <div class="event-card">
            <div class="event-date">
              <span class="month">${monthNames[date.getMonth()]}</span>
              <span class="day">${date.getDate()}</span>
              <span class="year">${date.getFullYear()}</span>
            </div>
            <div class="event-content">
              <div class="event-tag general">General</div>
              <h3>${event.title}</h3>
              <p>${event.description}</p>
              <div class="event-meta">
                <div class="meta-item">
                  <i class="bi bi-clock"></i>
                  <span>${startTime} - ${endTime}</span>
                </div>
                <div class="meta-item">
                  <i class="bi bi-geo-alt"></i>
                  <span>${event.location || "Campus Venue"}</span>
                </div>
              </div>
              <div class="event-actions">
                <a href="/events" class="btn-learn-more">See More Events</a>
                <a href="${calendarUrl}" target="_blank" class="btn-calendar">
                  <i class="bi bi-calendar-plus"></i> Add to Calendar
                </a>
              </div>
            </div>
          </div>
        `;

        container.appendChild(col);
      });

      // Convert "15:04" => "03:04 PM"
      function convertTo12Hour(time24) {
        const [h, m] = time24.split(":").map(Number);
        const ampm = h >= 12 ? "PM" : "AM";
        const hour = h % 12 || 12;
        return `${hour.toString().padStart(2, "0")}:${m
          .toString()
          .padStart(2, "0")} ${ampm}`;
      }

      // Format for Google Calendar link
      function formatForCalendar(dateObj, time24) {
        const [h, m] = time24.split(":").map(Number);
        const iso = new Date(dateObj);
        iso.setHours(h, m, 0);
        return iso.toISOString().replace(/[-:]/g, "").split(".")[0] + "Z";
      }
    } catch (err) {
      console.error("Error loading events:", err);
    }
  });
</script>

