<%- include('partials/header-sidebar') %>
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">

    <style>
        /* body {
        background: linear-gradient(to right, #f8f9fa, #e9ecef);
      }

      .card {
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
        border: none;
