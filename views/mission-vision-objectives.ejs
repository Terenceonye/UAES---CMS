<%- include("websitepartials/header") %>
  <main class="main">

    <!-- Page Title -->
    <div class="page-title dark-background"
      style="background-image: url(website-assets/img/gallery/Dr-Basilia-Igbokwe3.jpg);">
      <div class="container position-relative">
        <h1>About</h1>
        <p>Mission, Vision, and Objectives</p>
        <nav class="breadcrumbs">
          <ol>
            <li><a href="/">Home</a></li>
            <li class="current">About</li>
          </ol>
        </nav>
      </div>
    </div><!-- End Page Title -->

    <section id="history" class="history section">

      <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row align-items-center g-5">
          <div class="col-lg-6">
            <div class="about-content" data-aos="fade-up" data-aos-delay="200">
              <h3>Our Purpose</h3>
              <h2>Mission, Vision, and Objectives</h2>
              <p>Federal Polytechnic, Nekede was established to address the need for skilled manpower in science,
                engineering, and technology. The institution is committed to producing graduates who are not only
                self-employable but also job creators. Below are our guiding principles:</p>

              <div class="timeline">
                <div class="timeline-item">
                  <div class="timeline-dot"></div>
                  <div class="timeline-content">
                    <h4>Objectives</h4>
                    <p>Providing training, research, and development in applied arts, sciences, technology,
                      management, and commerce.</p>
                  </div>
                </div>

                <div class="timeline-item">
                  <div class="timeline-dot"></div>
                  <div class="timeline-content">
                    <p>Offering full-time and part-time courses leading to diplomas, certificates, and other
                      qualifications.</p>
                  </div>
                </div>

                <div class="timeline-item">
                  <div class="timeline-dot"></div>
                  <div class="timeline-content">
                    <p>Organizing conferences, seminars, and public lectures to disseminate knowledge.</p>
                  </div>
                </div>

                <div class="timeline-item">
                  <div class="timeline-dot"></div>
                  <div class="timeline-content">
                    <p>Preparing students for examinations set by the Institution or other examining bodies.</p>
                  </div>
                </div>

                <div class="timeline-item">
                  <div class="timeline-dot"></div>
                  <div class="timeline-content">
                    <p>Developing techniques to meet the needs of Imo State and Nigeria.</p>
                  </div>
                </div>

              </div>
            </div>
          </div>

          <div class="col-lg-6">
            <div class="about-image" data-aos="zoom-in" data-aos-delay="300">
              <img src="website-assets/img/school-images/3rd-Solemn-assembly.jpg" alt="Campus"
                class="img-fluid rounded">

              <div class="mission-vision" data-aos="fade-up" data-aos-delay="400">
                <div class="mission">
                  <h3>Our Mission</h3>
                  <p>Nurture and sustain the best practices in teaching, learning, research, and technological
                    innovations to produce job creators for the global economy.</p>
                </div>

                <div class="vision">
                  <h3>Our Vision</h3>
                  <p>To be pacesetters in demand-driven technology and innovations, driving societal progress through
                    "Knowledge and Skill for Service."</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="row mt-5">
          <div class="col-lg-12">
            <div class="core-values" data-aos="fade-up" data-aos-delay="500">
              <h3 class="text-center mb-4">Institutional Mandates</h3>
              <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
                <div class="col">
                  <div class="value-card">
                    <div class="value-icon">
                      <i class="bi bi-book"></i>
                    </div>
                    <h4>Training & Research</h4>
                    <p>Advancing applied arts, sciences, technology, management, and commerce through structured
                      learning and innovation.</p>
                  </div>
                </div>

                <div class="col">
                  <div class="value-card">
                    <div class="value-icon">
                      <i class="bi bi-mortarboard"></i>
                    </div>
                    <h4>Academic Certification</h4>
                    <p>Delivering both full-time and part-time programs that lead to accredited diplomas and
                      certificates.</p>
                  </div>
                </div>

                <div class="col">
                  <div class="value-card">
                    <div class="value-icon">
                      <i class="bi bi-bar-chart-line"></i>
                    </div>
                    <h4>Societal Impact</h4>
                    <p>Innovating solutions to meet the industrial and societal needs of Imo State and Nigeria at large.
                    </p>
                  </div>
                </div>

                <div class="col">
                  <div class="value-card">
                    <div class="value-icon">
                      <i class="bi bi-megaphone"></i>
                    </div>
                    <h4>Knowledge Dissemination</h4>
                    <p>Hosting conferences, seminars, and public lectures to share insights and academic advancements.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>

